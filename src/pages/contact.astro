---
import Base from '../layouts/Base.astro';
import { getPage, site } from '../lib/content';

const page = getPage('contact');
const intro = page.blocks.find((b) => b.type === 'text');

// Squarespace's form handler goes away with the subscription and a static site has
// nothing to replace it with, so the page just points at Shannon's inbox.
const mailto = site.social.find((s) => s.service === 'email')?.url;
const address = mailto?.replace('mailto:', '');
---

<Base title="Contact" description="Get in touch with Shannon Collins." banner={page.banner}>
  <h1 class="page-title sr-only">Contact</h1>

  {intro && <div class="prose" set:html={intro.html} />}

  {
    address && (
      <p class="prose">
        Email me at <a href={mailto}>{address}</a>.
      </p>
    )
  }
</Base>
