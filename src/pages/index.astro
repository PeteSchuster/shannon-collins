---
import Base from '../layouts/Base.astro';
import { getPage, site } from '../lib/content';

// The old homepage was the "Welcome" page: nothing but the banner illustration.
const page = getPage('home');
---

<Base banner={page.banner} description={site.tagline}>
  {/* The page is purely an image, but it still needs a heading for screen readers. */}
  <h1 class="page-title sr-only">{site.title}</h1>
</Base>
