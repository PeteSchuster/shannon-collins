---
import { Image } from 'astro:assets';
import { image, type ImageRef } from '../lib/content';

interface Props {
  images: ImageRef[];
  /** Used to build honest alt text for slides Squarespace never captioned. */
  label: string;
}

const { images, label } = Astro.props;
---

<div class="slideshow" data-slideshow>
  <div class="slideshow__stage">
    <button class="slideshow__arrow slideshow__arrow--prev" type="button" data-prev aria-label="Previous image" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
        ><path d="M15 4 7 12l8 8" /></svg
      >
    </button>

    <ul class="slideshow__track" data-track tabindex="0" aria-label={`${label} — image gallery`}>
      {
        images.map((img, i) => (
          <li class="slideshow__slide" data-slide>
            <Image
              src={image(img.src)}
              alt={img.alt || `${label}, image ${i + 1} of ${images.length}`}
              widths={[640, 1046, 1600]}
              sizes="(max-width: 1140px) 100vw, 1046px"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </li>
        ))
      }
    </ul>

    <button class="slideshow__arrow slideshow__arrow--next" type="button" data-next aria-label="Next image" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
        ><path d="m9 4 8 8-8 8" /></svg
      >
    </button>
  </div>

  {
    images.length > 1 && (
      <ul class="slideshow__thumbs" data-thumbs>
        {images.map((img, i) => (
          <li>
            <button class="slideshow__thumb" type="button" data-thumb={i} aria-label={`Go to image ${i + 1}`}>
              <Image src={image(img.src)} alt="" width={160} height={160} loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style lang="scss">
  @use '../styles/abstracts/breakpoints' as *;

  .slideshow {
    margin-bottom: var(--gap-block);

    /*
     * A scroll-snap track rather than a JS carousel: it already works with touch,
     * trackpads, and keyboard before a single byte of script runs, so the enhancement
     * in the script below only has to add arrows and thumbnail syncing.
     */
    &__stage {
      position: relative;
    }

    &__track {
      display: flex;
      margin: 0;
      padding: 0;
      list-style: none;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      &:focus-visible {
        /* px: focus rings stay crisp regardless of text size. */
        outline: 2px solid var(--ink);
        outline-offset: 4px;
      }
    }

    &__slide {
      flex: 0 0 100%;
      scroll-snap-align: center;
      scroll-snap-stop: always;

      :global(img) {
        width: 100%;
        max-height: min(72vh, 45rem);
        object-fit: contain;
      }
    }

    /*
     * Arrows are always visible on touch devices (which never hover) and fade in on
     * hover or keyboard focus everywhere else.
     */
    &__arrow {
      position: absolute;
      top: 50%;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      transform: translateY(-50%);
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.82);
      color: var(--ink);
      cursor: pointer;
      opacity: 1;
      transition:
        opacity 0.2s ease,
        background 0.2s ease;

      svg {
        width: 1.375rem;
        height: 1.375rem;
      }

      &--prev {
        left: 0.875rem;
      }

      &--next {
        right: 0.875rem;
      }

      &:disabled {
        cursor: default;
        opacity: 0 !important;
      }

      @media (hover: hover) {
        opacity: 0;

        &:focus-visible {
          opacity: 1;
        }
      }
    }

    @media (hover: hover) {
      &__stage:hover &__arrow {
        opacity: 1;
      }
    }

    &__thumbs {
      display: flex;
      gap: 0.5rem;
      margin: 1.25rem 0 0;
      padding: 0 0 0.375rem;
      list-style: none;
      overflow-x: auto;
      scrollbar-width: thin;

      li {
        flex: 0 0 auto;
      }
    }

    &__thumb {
      display: block;
      width: 3.5rem;
      height: 3.5rem;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
      opacity: 0.45;
      transition: opacity 0.2s ease;

      :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      &:hover,
      &[aria-current='true'] {
        opacity: 1;
      }

      @include from('sm') {
        width: 5rem;
        height: 5rem;
      }
    }
  }
</style>

<script>
  class Slideshow {
    private track: HTMLElement;
    private slides: HTMLElement[];
    private thumbs: HTMLElement[];
    private prev: HTMLButtonElement | null;
    private next: HTMLButtonElement | null;
    private index = 0;

    constructor(root: HTMLElement) {
      this.track = root.querySelector('[data-track]')!;
      this.slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
      this.thumbs = [...root.querySelectorAll<HTMLElement>('[data-thumb]')];
      this.prev = root.querySelector('[data-prev]');
      this.next = root.querySelector('[data-next]');

      if (this.slides.length > 1) {
        this.prev?.removeAttribute('hidden');
        this.next?.removeAttribute('hidden');
      }

      this.prev?.addEventListener('click', () => this.go(this.index - 1));
      this.next?.addEventListener('click', () => this.go(this.index + 1));

      this.thumbs.forEach((thumb) =>
        thumb.addEventListener('click', () => this.go(Number(thumb.dataset.thumb))),
      );

      this.track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') this.go(this.index - 1);
        else if (event.key === 'ArrowRight') this.go(this.index + 1);
        else return;
        event.preventDefault();
      });

      // The track is the source of truth: it moves on swipe and trackpad scroll too,
      // so derive the active index from what is actually centred.
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) this.setIndex(this.slides.indexOf(visible.target as HTMLElement));
        },
        { root: this.track, threshold: [0.5, 0.75, 1] },
      );
      this.slides.forEach((slide) => observer.observe(slide));

      this.setIndex(0);
    }

    private go(to: number) {
      const clamped = Math.max(0, Math.min(this.slides.length - 1, to));
      // Animate a step, but jump a thumbnail click: sliding through 20-odd images is
      // slow, and `scroll-snap-stop: always` can strand a smooth scroll partway.
      const behavior = Math.abs(clamped - this.index) > 1 ? 'instant' : 'smooth';
      this.slides[clamped]?.scrollIntoView({ behavior, block: 'nearest', inline: 'center' });
      this.setIndex(clamped);
    }

    private setIndex(to: number) {
      if (to < 0) return;
      this.index = to;
      this.thumbs.forEach((thumb, i) =>
        thumb.setAttribute('aria-current', String(i === to)),
      );
      this.thumbs[to]?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (this.prev) this.prev.disabled = to === 0;
      if (this.next) this.next.disabled = to === this.slides.length - 1;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((el) => new Slideshow(el));
</script>
