---
import { Image } from 'astro:assets';
import { site, image, url } from '../lib/content';

const links = [
  { label: 'Illustration', href: url('/illustration') },
  // Shannon's photography lives on a separate site; the old nav pointed off-site too.
  { label: 'Photography', href: 'https://www.shannoncollins.com', external: true },
  { label: 'About', href: url('/about') },
  { label: 'Contact', href: url('/contact') },
];

const strip = (p: string) => '/' + p.replace(/^\/|\/$/g, '');
const path = strip(Astro.url.pathname);
const isCurrent = (href: string) => {
  const target = strip(href);
  return path === target || path.startsWith(target + '/');
};
---

<header class="masthead">
  <a class="masthead__logo" href={url('/')} aria-label={`${site.title} — home`}>
    <Image src={image(site.logo)} alt={site.title} width={290} densities={[1, 2]} loading="eager" />
  </a>

  <nav class="nav" aria-label="Main">
    <ul class="nav__list">
      {
        links.map(({ label, href, external }) => (
          <li>
            <a
              class="nav__link"
              href={href}
              aria-current={!external && isCurrent(href) ? 'page' : undefined}
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
