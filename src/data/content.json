    "about": {
      "title": "About",
      "description": "",
      "banner": {
        "src": "branding-photos3-3.jpg",
        "alt": "About"
      },
      "blocks": [
        {
          "type": "text",
          "html": "<p>Shannon Collins is an illustrator and <a href=\"http://www.shannoncollins.com\" target=\"_blank\" rel=\"noopener noreferrer\">photographer</a> based in the Philadelphia area. They hold a BFA from Kutztown University in Communication Design with a major in Illustration. They use mostly traditional materials in their work — watercolors, colored pencils, markers, and ink — with a particular interest in color and texture.&nbsp;</p><p>Their freelance work has been seen in Urban Outfitters stores worldwide, on exhibit at the Philadelphia International Airport, and in galleries throughout the Philadelphia area. </p><p><a href=\"http://www.themorewesee.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Photo by </a><a href=\"https://theonash.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Theo Nash</a></p>"
        }
      ]
    },
